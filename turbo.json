{
  "$schema": "https://turbo.build/schema.json",
  "concurrency": "32",
  "globalEnv": ["NODE_ENV"],
  // Turbo runs tasks in a filtered environment: anything not declared here (or
  // in a task's own `env`) never reaches the process. These are runtime knobs
  // that change behaviour without changing build output, so they pass through
  // without participating in the cache hash.
  //
  // `OM_LOG_LEVEL` was silently dropped this way — `OM_LOG_LEVEL=debug yarn
  // start` looked like it worked and produced no debug output, which cost a
  // diagnostic at the moment it was needed.
  "globalPassThroughEnv": ["OM_LOG_LEVEL", "OM_AUTHORITY_SHADOW"],
  "globalDependencies": ["scripts/build-package.mjs", "scripts/watch.mjs", "scripts/lib/add-js-extension.mjs"],
  "tasks": {
    "build": {
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "generated/**"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "@open-mercato/cli#build": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "generated/**"],
      "outputs": ["dist/**"]
    },
    "create-mercato-app#build": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["$TURBO_DEFAULT$", "generated/**"],
      "outputs": ["dist/**"]
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "watch": {
      "cache": false,
      "persistent": true
    },
    "mcp:dev": {
      "cache": false,
      "persistent": true
    },
    "mcp:serve": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "cache": true,
      "outputs": []
    },
    "test": {
      "cache": false,
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "generate": {
      "cache": false,
      "outputs": [".mercato/**"]
    },
    "db:generate": {
      "cache": false,
      "outputs": []
    },
    "db:migrate": {
      "cache": false,
      "outputs": []
    },
    "db:greenfield": {
      "cache": false,
      "outputs": []
    },
    "reinstall": {
      "cache": false,
      "outputs": []
    },
    "initialize": {
      "cache": false,
      "outputs": []
    },
    "seed:defaults": {
      "cache": false,
      "outputs": []
    }
  }
}
